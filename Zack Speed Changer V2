local function toggleGuiVisibility()
    guiVisible = not guiVisible
    sound:Play()
    
    local targetSize = guiVisible and UDim2.new(0, 240, 0, 360) or UDim2.new(0, 0, 0, 0)
    
    if guiVisible then 
        gui.Enabled = true 
    end
    
    local tweenInfo = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    local tween = TweenService:Create(frame, tweenInfo, {
        Size = targetSize
    })
    
    tween:Play()
    tween.Completed:Connect(function()
        if not guiVisible then 
            -- Keep ScreenGui enabled so the floating hide button stays visible
        end
    end)
end

hideButton.MouseButton1Click:Connect(function()
    toggleGuiVisibility()
end)

-- Make Hide Button Draggable for Mobile Users
local hideDragging, hideDragStart, hideStartPos
hideButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        hideDragging = true
        hideDragStart = input.Position
        hideStartPos = hideButton.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if hideDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - hideDragStart
        hideButton.Position = UDim2.new(hideStartPos.X.Scale, hideStartPos.X.Offset + delta.X, hideStartPos.Y.Scale, hideStartPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        hideDragging = false
    end
end)

local function setSpeed(newSpeed)
    speed = newSpeed
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
    if humanoid then
        humanoid.WalkSpeed = speed
    end
end

textBox.FocusLost:Connect(function(enterPressed)
    local newSpeed = tonumber(textBox.Text)
    if newSpeed then 
        setSpeed(newSpeed) 
    end
    textBox.Text = ""
end)

button.MouseButton1Click:Connect(function()
    setSpeed(defaultSpeed)
    textBox.Text = ""
end)

RunService.Stepped:Connect(function()
    local character = player.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.WalkSpeed ~= speed then
            humanoid.WalkSpeed = speed
        end
    end
    
    local hue = (tick() % 4) / 4
    uiStroke.Color = Color3.fromHSV(hue, 1, 1)
end)

bindButton.MouseButton1Click:Connect(function()
    isChangingKeybind = true
    bindButton.Text = "Press any key..."
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if isChangingKeybind and not gameProcessed then
        if input.KeyCode ~= Enum.KeyCode.Unknown then
            currentKeybind = input.KeyCode
            bindButton.Text = "Keybind: [ " .. string.sub(tostring(currentKeybind), 14) .. " ]"
            isChangingKeybind = false
        end
        return
    end

    if input.KeyCode == currentKeybind and not gameProcessed then
        toggleGuiVisibility()
    end
end)
