local mt = getrawmetatable and getrawmetatable(game)
if mt and setreadonly then
    setreadonly(mt, false)
    local oldIndex = mt.__index
    local oldNewIndex = mt.__newindex
    local oldNamecall = mt.__namecall

    mt.__index = newcclosure(function(self, key)
        if not checkcaller() then
            if self:IsA("Humanoid") and (key == "WalkSpeed" or key == "walkSpeed") then
                return defaultSpeed
            end
        end
        return oldIndex(self, key)
    end)

    mt.__newindex = newcclosure(function(self, key, value)
        if not checkcaller() then
            if self:IsA("Humanoid") and (key == "WalkSpeed" or key == "walkSpeed") then
                return
            end
        end
        oldNewIndex(self, key, value)
    end)

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if not checkcaller() and (method == "Kick" or method == "kick") and self == player then
            return
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
end

if hookmetamethod then
    local oldInstanceKick
    oldInstanceKick = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if not checkcaller() and (method == "Kick" or method == "kick") and self == player then
            return
        end
        return oldInstanceKick(self, ...)
    end)
end

