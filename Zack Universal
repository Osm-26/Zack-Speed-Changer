-- Instant Page Builder
local function createPage(name, order)
    local page = Instance.new("Frame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.Position = UDim2.new(0, 0, 0, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.Parent = pageContainer
    
    local pageLayout = Instance.new("UIListLayout")
    pageLayout.Padding = UDim.new(0, 5)
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Parent = page
    
    pages[name] = page
    
    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(0.2, -2, 1, 0)
    tabBtn.Text = name
    tabBtn.BackgroundColor3 = Theme.Card
    tabBtn.BackgroundTransparency = Theme.CardTransparency
    tabBtn.TextColor3 = Theme.TextDim
    tabBtn.Font = Enum.Font.GothamBold
    tabBtn.TextSize = 9
    tabBtn.BorderSizePixel = 0
    tabBtn.LayoutOrder = order
    tabBtn.Parent = tabContainer
    
    local tabCorner = Instance.new("UICorner")
    tabCorner.CornerRadius = UDim.new(0, 6)
    tabCorner.Parent = tabBtn
    
    tabButtons[name] = tabBtn
    
    tabBtn.MouseButton1Click:Connect(function()
        if activePage == page then return end
        
        sound:Play()
        if activePage then
            activePage.Visible = false
        end
        
        activePage = page
        page.Position = UDim2.new(0, 0, 0, 0)
        page.Visible = true
        
        for pName, btn in pairs(tabButtons) do
            local isSelected = (pName == name)
            btn.BackgroundTransparency = isSelected and Theme.AccentTransparency or Theme.CardTransparency
            btn.TextColor3 = isSelected and Theme.NeonCyan or Theme.TextDim
            btn.BackgroundColor3 = isSelected and Theme.Header or Theme.Card
        end
    end)
    
    return page
end

