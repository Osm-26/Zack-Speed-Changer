-- Custom Hide/Show Engine
local function toggleGuiVisibility()
    guiVisible = not guiVisible
    sound:Play()

    local activeHeight = isMinimized and minimizedHeight or expandedHeight

    if animSpeed == 0 then
        frame.Visible = guiVisible
        frame.Size = UDim2.new(0, uiWidth, 0, activeHeight)
        frame.BackgroundTransparency = Theme.BackgroundTransparency
        return
    end

    if guiVisible then
        frame.Visible = true
        frame.Size = UDim2.new(0, uiWidth - 20, 0, activeHeight - 20)
        frame.BackgroundTransparency = 1
        
        TweenService:Create(frame, TweenInfo.new(animSpeed, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, uiWidth, 0, activeHeight),
            BackgroundTransparency = Theme.BackgroundTransparency
        }):Play()
    else
        local tweenOut = TweenService:Create(frame, TweenInfo.new(animSpeed, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Size = UDim2.new(0, uiWidth - 20, 0, activeHeight - 20),
            BackgroundTransparency = 1
        })
        tweenOut:Play()
        tweenOut.Completed:Connect(function()
            if not guiVisible then 
                frame.Visible = false 
            end
        end)
    end
end

hideButton.MouseButton1Click:Connect(function()
    if isClick then
        toggleGuiVisibility()
    end
end)

