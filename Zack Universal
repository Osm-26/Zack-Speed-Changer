    if animSpeed > 0 then
        local tween = TweenService:Create(frame, TweenInfo.new(animSpeed, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, uiWidth, 0, targetHeight)
        })
        tween:Play()

